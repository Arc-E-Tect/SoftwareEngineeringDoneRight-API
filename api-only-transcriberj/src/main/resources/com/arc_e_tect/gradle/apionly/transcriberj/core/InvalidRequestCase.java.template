/**
 * A request that is valid except for exactly one constraint the contract declares on its
 * request input, and the response the contract declares for an invalid request. Derived
 * from the contract alone, and listed, in canonical order, by {@code CASES} on each
 * operation's {@code InvalidRequests} class.
 *
 * <p>The request is the operation's smallest valid request with that one change made. Its
 * values are raw: encoding them for the path, the query or a header is the renderer's job.
 *
 * @param id                   readable, unique within its operation and the same on every run,
 *                             such as {@code body-emailAddress-maxLength}; a test method name
 *                             and a snippet directory can be made from it
 * @param description          one sentence saying what is wrong with the request
 * @param in                   where the fault is: {@code path}, {@code query}, {@code header}
 *                             or {@code body}
 * @param name                 the parameter's name, or null when the fault is in the body
 * @param pointer              the JSON pointer of the fault in the body, the empty string for
 *                             the body as a whole, or null when the fault is in a parameter
 * @param keyword              the constraint violated, as the contract spells it
 * @param request              the complete violating request
 * @param expectedStatus       the status the contract declares for an invalid request
 * @param expectedContentTypes every content type that response is declared with; empty when
 *                             it has no content, and only the status is expected
 * @param responseBodyClass    the simple name of the generated class for that response's
 *                             body, in this package, or null when it has none
 * @param representative       whether this is the case whose documentation is published: the
 *                             first of its operation
 */
@com.arc_e_tect.sedr.utils.jacoco.marker.ExcludeFromJacocoGeneratedCodeCoverage(justification = "Generated by API-Only TranscriberJ")
public record InvalidRequestCase(String id, String description, String in, String name, String pointer,
                                 String keyword, ContractRequest request, int expectedStatus,
                                 java.util.List<String> expectedContentTypes, String responseBodyClass,
                                 boolean representative) {
}
