package ${package};

import java.util.ArrayList;
import java.util.List;
import java.util.Locale;
import java.util.MissingResourceException;
import java.util.ResourceBundle;

/**
 * Where this contract's classes get their descriptions.
 *
 * <p>A description resolves in one order, at the moment it is asked for: this project's
 * {@link ResourceBundle} first, then the text generation produced -- the contract's, or
 * the placeholder. A key the bundle does not carry, a bundle that is not on the classpath
 * and an entry that is blank all fall through to that text, so a description is never
 * empty and resolving one never throws.
 *
 * <p>Resolving at the moment it is asked for is what lets one generated tree document a
 * contract in several languages: ask for a {@link Locale}, or set
 * {@code ${localeProperty}}, and the same classes answer in that language.
 *
 * <p>Dependency-free on purpose: {@link ResourceBundle} is {@code java.util}.
 */
@com.arc_e_tect.sedr.utils.jacoco.marker.ExcludeFromJacocoGeneratedCodeCoverage(justification = "Generated by API-Only TranscriberJ")
public final class ContractDescriptions {

    /** The bundle the project configured, as {@code apiOnlyTranscriberJ} names it. */
    public static final String BUNDLE = ${bundle};

    /** The system property that names another bundle, for one run. */
    public static final String BUNDLE_PROPERTY = "${bundleProperty}";

    /** The system property that names the locale to resolve in, for one run. */
    public static final String LOCALE_PROPERTY = "${localeProperty}";

    private static final List<String> KEYS = List.of(
${keys});

    /**
     * Resolves a locale, then its parents, then the base bundle -- and never the JVM's own
     * locale in between, so the language asked for is the language answered.
     */
    private static final ResourceBundle.Control NO_JVM_LOCALE =
            ResourceBundle.Control.getNoFallbackControl(ResourceBundle.Control.FORMAT_DEFAULT);

    private ContractDescriptions() {
    }

    /**
     * Every key a bundle for this contract may carry, in the order the classes declare
     * them: a class's own name, and a field's {@code <ClassName>.<path>}.
     *
     * @return the keys
     */
    public static List<String> keys() {
        return KEYS;
    }

    /**
     * The keys nothing covers in the locale this run resolves in, so that their
     * descriptions are the ones generation produced.
     *
     * @return those keys, in {@link #keys()} order
     */
    public static List<String> missing() {
        return missing(locale());
    }

    /**
     * The keys nothing covers in a locale, following {@link ResourceBundle}'s parent
     * chain: what a reader in that locale sees fall back to the generated text.
     *
     * @param locale the locale
     * @return those keys, in {@link #keys()} order
     */
    public static List<String> missing(Locale locale) {
        List<String> missing = new ArrayList<>();
        for (String key : KEYS) {
            if (fromBundle(key, locale) == null) {
                missing.add(key);
            }
        }
        return List.copyOf(missing);
    }

    /**
     * The keys that locale's own bundle does not carry, whatever it inherits.
     *
     * <p>{@link #missing(Locale)} answers a reader's question -- which descriptions fall
     * back to the generated text -- and follows {@link ResourceBundle}'s parent chain, so a
     * key the base bundle carries is not missing in any locale. This answers a translator's:
     * which keys this language has no text of its own for, however complete the base is.
     *
     * <p>It reads {@code <bundle>_<language>.properties} directly, so it says nothing about
     * a bundle that is a class rather than a properties file.
     *
     * @param locale the locale to check, whose language names the file
     * @return the keys that locale has no text of its own for, in {@link #keys()} order
     */
    public static List<String> untranslated(Locale locale) {
        String baseName = System.getProperty(BUNDLE_PROPERTY, BUNDLE);
        java.util.Properties own = new java.util.Properties();
        String resource = baseName.replace('.', '/') + (locale.getLanguage().isEmpty() ? ""
                : "_" + locale.getLanguage()) + ".properties";
        try (java.io.InputStream in = ContractDescriptions.class.getClassLoader().getResourceAsStream(resource)) {
            if (in != null) {
                own.load(new java.io.InputStreamReader(in, java.nio.charset.StandardCharsets.UTF_8));
            }
        } catch (java.io.IOException e) {
            return KEYS;
        }
        List<String> untranslated = new ArrayList<>();
        for (String key : KEYS) {
            String text = own.getProperty(key);
            if (text == null || text.isBlank()) {
                untranslated.add(key);
            }
        }
        return List.copyOf(untranslated);
    }

    /**
     * The description of a key: the bundle's, or the text generation produced.
     *
     * @param key       the key, as {@link #keys()} lists it
     * @param generated what generation produced for it
     * @return the description, never empty
     */
    public static String of(String key, String generated) {
        return of(key, generated, locale());
    }

    /**
     * The description of a key in a locale: the bundle's, or the text generation produced.
     *
     * @param key       the key, as {@link #keys()} lists it
     * @param generated what generation produced for it
     * @param locale    the locale to resolve in
     * @return the description, never empty
     */
    public static String of(String key, String generated, Locale locale) {
        String described = fromBundle(key, locale);
        return described != null ? described : generated;
    }

    /** The bundle's text for a key, or null when it has none worth using. */
    private static String fromBundle(String key, Locale locale) {
        String baseName = System.getProperty(BUNDLE_PROPERTY, BUNDLE);
        if (baseName.isEmpty()) {
            return null;
        }
        try {
            // No fallback to the JVM's own locale: asked for English on a Dutch machine,
            // the default Control would answer from the Dutch file before the base one.
            ResourceBundle bundle = ResourceBundle.getBundle(baseName, locale,
                    ContractDescriptions.class.getClassLoader(), NO_JVM_LOCALE);
            String text = bundle.getString(key);
            return text.isBlank() ? null : text;
        } catch (MissingResourceException e) {
            return null;
        }
    }

    /**
     * The locale this run resolves in: the one {@code ${localeProperty}} names, else the
     * JVM's. What a generated {@code description()} or {@code fields(String)} uses when
     * the caller names no locale of its own.
     *
     * @return the locale
     */
    public static Locale locale() {
        String configured = System.getProperty(LOCALE_PROPERTY);
        return configured == null || configured.isBlank()
                ? Locale.getDefault() : Locale.forLanguageTag(configured.replace('_', '-'));
    }
}
