/**
 * What a contract case tests: which response the contract declares for its request, and so what
 * a target must do before the request is sent.
 */
@com.arc_e_tect.sedr.utils.jacoco.marker.ExcludeFromJacocoGeneratedCodeCoverage(justification = "Generated by API-Only TranscriberJ")
public enum CaseKind {

    /**
     * A valid request, expecting an exact {@code 2xx} the operation declares. Requires state: the
     * resource exists for a read, an update or a delete, and does not for a create.
     */
    SUCCESS,

    /**
     * A valid request naming a resource that does not exist, expecting the declared {@code 404}.
     * Requires state: the resource the path names must be absent.
     */
    NOT_FOUND,

    /** A valid request whose {@code Accept} no declared response offers, expecting the declared {@code 406}. */
    NOT_ACCEPTABLE,

    /** The valid body sent with a content type the operation does not accept, expecting the declared {@code 415}. */
    UNSUPPORTED_MEDIA_TYPE,

    /** A request with exactly one constraint violated, expecting the declared invalid-request status. */
    INVALID_REQUEST
}
